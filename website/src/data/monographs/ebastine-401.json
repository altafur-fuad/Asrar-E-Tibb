{"id": "401", "name": "Ebastine", "slug": "ebastine-401", "monograph_link": "https://medex.com.bd/attachments/EPGCRsu5GWMQ4l7aaYcgrrgox40sga/ebastine-film-coated-tablets-prescribing-information", "drug_class": "Non-sedating antihistamines", "indication": "Urticaria", "indication_description": "<div class=\"ac-body\">Ebastine is indicated for the symptomatic treatment of:<br>\n<ul>\n<li>Seasonal and Perennial Allergic Rhinitis.</li>\n<li>Chronic Idiopathic Urticaria.</li>\n</ul></div>", "therapeutic_class_description": "<div class=\"ac-body\">Non-sedating antihistamines</div>", "pharmacology_description": "<div class=\"ac-body\">Ebastine is a long-acting and selective H1-histamine receptor antagonist. After repeated administration, inhibition of peripheral receptors remains at a constant level. Ebastine is rapidly absorbed and undergoes extensive first-pass metabolism following oral administration. Ebastine is almost totally converted to the pharmacologically active acid metabolite, carebastine.</div>", "dosage_description": "<div class=\"ac-body\">Tablet: <br>\n<ul>\n<li><strong>Adults (more than 12 years of age)</strong>: 10 mg (one tablet) once daily.</li>\n<li><strong>Children (6-12 years of age)</strong>: 5 mg (half tablet) once daily.</li>\n</ul>\nSyrup: <br>\n<ul>\n<li><strong>Children (2-5 years of age)</strong>: 2.5 ml once daily (upto 5 ml in severe cases such as Perennial Allergic Rhinitis).</li>\n<li><strong>Children (6-12 years of age)</strong>: 5 ml once daily (upto 10 ml in severe cases such as Perennial Allergic Rhinitis).</li>\n</ul>\nEbastine may be taken with or without food.</div>", "administration_description": "", "interaction_description": "<div class=\"ac-body\">Ebastine in combination with either ketoconazole or erythromycin increases in plasma level of ebastine and prolonged QTc interval. Ebastine does not interact with the pharmacokinetics of theophylline, warfarin, cimetidine, diazepam or alcohol. The sedation effect of alcohol and diazepam may be enhanced.</div>", "contraindications_description": "<div class=\"ac-body\">Patients with a known hypersensitivity to Ebastine or any of its ingredients.</div>", "side_effects_description": "<div class=\"ac-body\">The most common side-effects are headache, dry mouth and drowsiness. Less commonly reported side effects include abdominal pain, dyspepsia, nausea and insomnia.</div>", "pregnancy_and_lactation_description": "", "precautions_description": "", "pediatric_usage_description": "", "overdose_effects_description": "<div class=\"ac-body\">No clinically meaningful signs or symptoms were observed up to 100 mg given once daily. There is no specific antidote for Ebastine. In case of accidental overdoses, gastric lavage, monitoring of vital functions including ECG and symptomatic treatment should be carried out.</div>", "duration_of_treatment_description": "", "reconstitution_description": "", "storage_conditions_description": "<div class=\"ac-body\">Store below 30°C at a cool and dry place, away from light. Keep out of reach of children</div>", "brands": [{"id": "12028", "name": "Alestin", "slug": "alestintablet10-mg", "dosage_form": "Tablet", "strength": "10 mg", "manufacturer": "Novelta Bestway Pharma Ltd.", "price": "৳ 6.00", "package_container": "Unit Price: ৳ 6.00,(50's pack: ৳ 300.00),"}, {"id": "12029", "name": "Alestin", "slug": "alestinsyrup5-mg5-ml", "dosage_form": "Syrup", "strength": "5 mg/5 ml", "manufacturer": "Novelta Bestway Pharma Ltd.", "price": "৳ 80.00", "package_container": "50 ml bottle: ৳ 80.00"}, {"id": "12046", "name": "Ebahist", "slug": "ebahistsyrup5-mg5-ml", "dosage_form": "Syrup", "strength": "5 mg/5 ml", "manufacturer": "Globe Pharmaceuticals Ltd.", "price": "৳ 80.00", "package_container": "50 ml bottle: ৳ 80.00"}, {"id": "27767", "name": "Ebatrol", "slug": "ebatrolsyrup5-mg5-ml", "dosage_form": "Syrup", "strength": "5 mg/5 ml", "manufacturer": "Delta Pharma Ltd.", "price": "৳ 80.00", "package_container": "50 ml bottle: ৳ 80.00"}