{"id": "987", "name": "Silymarin [Milk thistle]", "slug": "silymarin-milk-thistle-987", "monograph_link": "", "drug_class": "Cholagogues, Cholelitholytics & Hepatic Protectors", "indication": "Jaundice", "indication_description": "<div class=\"ac-body\">Silymarin (Milk thistle) is indicated for the treatment and prevention of-<br>\n<ul>\n<li>Liver disease, (non-alcoholic &amp; alcoholic)</li>\n<li>Liver cirrhosis, (non-alcoholic &amp; alcoholic)</li>\n<li>Infectious hepatitis</li>\n<li>Drug-induced hepatitis</li>\n<li>Liver disease secondary to diabetes mellitus</li>\n<li>Toxicity of narcotics</li>\n<li>Fatty liver</li>\n<li>Jaundice</li>\n</ul></div>", "therapeutic_class_description": "<div class=\"ac-body\">Cholagogues, Cholelitholytics &amp; Hepatic Protectors, Herbal and Nutraceuticals</div>", "pharmacology_description": "<div class=\"ac-body\">Silymarin, a flavonoid complex of Silybum marianum or Milk thistle, is the biologically active component. It provides hepatocellular protection through toxin blockade at the membrane level, enhances protein synthesis, antioxidant activity, anti-fibrotic activity and possible anti-inflammatory or immunomodulating effects.</div>", "dosage_description": "<div class=\"ac-body\">1 capsule 2 to 3 times daily or as directed by a physician.</div>", "administration_description": "", "interaction_description": "<div class=\"ac-body\">Concomitant use of silymarin and butyrophenones or phenothiazines has resulted in the reduction of lipid peroxidation.</div>", "contraindications_description": "<div class=\"ac-body\">Contraindicated in patient with a known hypersensitivity to silymarin.</div>", "side_effects_description": "<div class=\"ac-body\">Well tolerated in the recommended dose. Occasionally a mild laxative effect may observe.</div>", "pregnancy_and_lactation_description": "<div class=\"ac-body\">No experience is available about the use of Silymarin 70 mg or 140 mg during pregnancy and lactation. Therefore, if needed Silymarin 70 mg or 140 mg should be taken with caution according to the physician’s advice.</div>", "precautions_description": "", "pediatric_usage_description": "", "overdose_effects_description": "", "duration_of_treatment_description": "", "reconstitution_description": "", "storage_conditions_description": "<div class=\"ac-body\">Store in a cool &amp; dry place, away from light &amp; moisture. Keep out of reach of children.</div>", "brands": [{"id": "31985", "name": "Bliss", "slug": "blisscapsule140-mg", "dosage_form": "Capsule", "strength": "140 mg", "manufacturer": "Purnava Limited", "price": "৳ 20.00", "package_container": "Unit Price: ৳ 20.00,(30's pack: ৳ 600.00),"}, {"id": "29595", "name": "Improliv", "slug": "improlivcapsule140-mg", "dosage_form": "Capsule", "strength": "140 mg", "manufacturer": "Veritas Pharmaceuticals Ltd.", "price": "৳ 9.00", "package_container": "Unit Price: ৳ 9.00,(30's pack: ৳ 270.00),"}, {"id": "31125", "name": "Hepanor", "slug": "hepanorcapsule70-mg", "dosage_form": "Capsule", "strength": "70 mg", "manufacturer": "Drug International Ltd.", "price": "৳ 6.00", "package_container": "Unit Price: ৳ 6.00,(32's pack: ৳ 192.00),"}, {"id": "29858", "name": "Hepanor", "slug": "hepanorcapsule140-mg", "dosage_form": "Capsule", "strength": "140 mg", "manufacturer": "Drug International Ltd.", "price": "৳ 9.00", "package_container": "Unit Price: ৳ 9.00,(20's pack: ৳ 180.00),"}, {"id": "28268", "name": "Hepamilk", "slug": "hepamilkcapsule70-mg", "dosage_form": "Capsule", "strength": "70 mg", "manufacturer": "ACME Laboratories Ltd.", "price": "৳ 5.00", "package_container": "Unit Price: ৳ 5.00,(30's pack: ৳ 150.00),,Unit Price: ৳ 5.00,(20's pack: ৳ 100.00),"}, {"id": "16676", "name": "Hepamilk", "slug": "hepamilkcapsule140-mg", "dosage_form": "Capsule", "strength": "140 mg", "manufacturer": "ACME Laboratories Ltd.", "price": "৳ 9.00", "package_container": "Unit Price: ৳ 9.00,(20's pack: ৳ 180.00),"}, {"id": "32094", "name": "Hepamarin", "slug": "hepamarincapsu