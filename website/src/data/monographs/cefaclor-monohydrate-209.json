rpediatric-drops125-mg125-ml", "dosage_form": "Pediatric Drops", "strength": "125 mg/1.25 ml", "manufacturer": "Leon Pharmaceuticals Ltd.", "price": "৳ 125.00", "package_container": "15 ml bottle: ৳ 125.00"}, {"id": "27757", "name": "Xclor", "slug": "xclorpowder-for-suspension125-mg5-ml", "dosage_form": "Powder for Suspension", "strength": "125 mg/5 ml", "manufacturer": "Orion Pharma Ltd.", "price": "৳ 190.57", "package_container": "100 ml bottle: ৳ 190.57"}]}