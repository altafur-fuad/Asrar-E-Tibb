{"id": "329", "name": "Desloratadine", "slug": "desloratadine-329", "monograph_link": "https://medex.com.bd/attachments/IyYRQw8j72OgHIuJNWDtIEG3Uysn6V/desloratadine-prescribing-information", "drug_class": "Non-sedating antihistamines", "indication": "Watery eye", "indication_description": "<div class=\"ac-body\"><div class=\"min-str-block\"><div class=\"min-str mb-5\" style=\"display: none;\">Desloratadine is indicated for the relief of symptoms associated with seasonal and perennial allergic rhinitis, such as sneezing, nasal discharge &amp; itching, congestion or stuffiness, as well as ocular itching, tearing and redness, itching of palate and coughing. Desloratadine is also indicated for <span class=\"min-str-toggle tx-green tx-bold\" style=\"cursor:pointer;font-style:italic;\">... Read more</span></div><div class=\"full-str\">Desloratadine is indicated for the relief of symptoms associated with seasonal and perennial allergic rhinitis, such as sneezing, nasal discharge &amp; itching, congestion or stuffiness, as well as ocular itching, tearing and redness, itching of palate and coughing. Desloratadine is also indicated for the relief of symptoms associated with chronic idiopathic urticaria such as the relief of itching and the size &amp; number of hives.</div></div></div>", "therapeutic_class_description": "<div class=\"ac-body\">Non-sedating antihistamines</div>", "pharmacology_description": "<div class=\"ac-body\">Desloratadine, the major active metabolite of Loratadine, is a non-sedating; long acting tricyclic histamine antagonist with selective H1-receptor histamine antagonist activity. Desloratadine also inhibits histamine release from human mast cell.</div>", "dosage_description": "<div class=\"ac-body\">Pediatric drops: <br>\n<ul>\n<li><strong>Child 6-11 months of age</strong>: 2 ml drops once daily.</li>\n<li><strong>Child 1-2 years of age</strong>: 2.5 ml drops once daily.</li>\n</ul>\nSyrup:<br>\n<ul>\n<li><strong>Child 6-11 months of age</strong>: 2 ml once daily.</li>\n<li><strong>Child 1-5 years of age</strong>: 2.5 ml once daily.</li>\n<li><strong>Child 6-11 years of age</strong>: 5 ml once daily.</li>\n<li><strong>Adults &amp; &gt;12 years of age</strong>: 10 ml once daily.</li>\n</ul>\nTablet: <br>\n<ul>\n<li><strong>Adults and children 12 years of age and over</strong>: 1 tablet daily</li>\n</ul></div>", "administration_description": "", "interaction_description": "<div class=\"ac-body\">No clinically relevant drug interactions have been reported.</div>", "contraindications_description": "<div class=\"ac-body\">Desloratadine is contraindicated in patients having hypersensitivity to this medication or to any of its ingredients or Loratadine.</div>", "side_effects_description": "<div class=\"ac-body\">Less common side effects may include headache, nausea, fatigue, dizziness, pharyngitis, dyspepsia and myalgia.</div>", "pregnancy_and_lactation_description": "<div class=\"ac-body\">Pregnancy Category C. The safe use of Desloratadine during pregnancy has not been established. Therefore, Desloratadine is not to be used during pregnancy unless clearly indicated. Desloratadine passes into breast milk, therefore a decision should be made whether to discontinue nursing or to discontinue Desloratadine taking into account the importance of the drug to the mother.</div>", "precautions_description": "<div class=\"ac-body\">In adult patients with liver or renal impairment: A starting dose of one 5 mg tablet every other day is recommended based on pharmacokinetic data. If the patient has medical or familial history of seizures.</div>", "pediatric_usage_description": "<div class=\"ac-body\">Recommended in the use in children &amp; adolescents.</div>", "overdose_effects_description": "<div class=\"ac-body\">No clinically relevant adverse effects have been reported.</div>", "duration_of_treatment_description": "", "reconstitution_description": "", "storage_conditions_description": "<div class=\"ac-body\">Store in a cool &amp; dry place, protected from light. Store below 30°C. Keep all medicines out of the reach of children.</div>", "brands": [{"id": "12227", "name": "Adlorin", "slug": "adlorintablet5-mg", "dosage_form": "Tablet", "strength": "5 mg", "manufacturer": "Ad-din Pharmaceuticals Ltd.", "price": "৳ 2.50", "package_container": "Unit Price: ৳ 2.50,(100's pack: ৳ 250.00),"}, {"id": "12228", "name": "Alertadin", "slug": "alertadintablet5-mg", "dosage_form": "Tablet", "strength": "5 mg", "manufacturer": "Beacon Pharmaceuticals Ltd.", "price": "৳ 2.51", "package_container": "Unit Price: ৳ 2.51,(100's pack: ৳ 251.00),"}, {"id": "27839", "name": "Aloran", "slug": "alorantablet5-mg", "dosage_form": "Tablet", "strength": "5 mg", "manufacturer": "Alco Pharma Ltd.", "price": "৳ 2.51", "package_container": "Unit Price: ৳ 2.51,(50's pack: ৳ 125.50),"}, {"id": "31191", "name": "Aslor", "slug": "aslorsyrup25-mg5-ml", "dosage_form": "Syrup", "strength": "2.5 mg/5 ml", "manufacturer": "Drug International Ltd.", "price": "৳ 30.10", "package_container": "60 ml bottle: ৳ 30.10"}, {"id": "12230", "name": "Aslor", "slug": "aslortablet5-mg", "dosage_form": "Tablet", "strength": "5 mg", "manufacturer": "Drug International Ltd.", "price": "৳ 3.00", "package_container": "Unit Price: ৳ 3.00,(100's pack: ৳ 300.00),"}, {"id": "19708", "name": "Benlor", "slug": "benlortablet5-mg", "dosage_form": "Tablet", "strength": "5 mg", "manufacturer": "Benham Pharmaceuticals Ltd.", "price": "৳ 3.00", "package_container": "Unit Price: ৳ 3.00,(100's pack: ৳ 300.00),"}, {"id": "12231", "name": "Clarex", "slug": "clarextablet5-mg", "dosage_form": "Tablet", "strength": "5 mg", "manufacturer": "Asiatic Laboratories Ltd.", "price": "৳ 2.50", "package_container": "Unit Price: ৳ 2.50,(50's pack: ৳ 125.00),"}, {"id": "12232", "name": "Deen", "slug": "deentablet5-mg", "dosage_form": "Tablet", "strength": "5 mg", "manufacturer": "Kemiko Pharmaceuticals Ltd.", "price": "৳ 2.51", "package_container": "Unit Price: ৳ 2.51,(50's pack: 