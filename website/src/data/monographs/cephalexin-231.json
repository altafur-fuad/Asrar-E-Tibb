", "dosage_form": "Capsule", "strength": "250 mg", "manufacturer": "Biopharma Laboratories Ltd.", "price": "৳ 6.52", "package_container": "Unit Price: ৳ 6.52,(30's pack: ৳ 195.60),"}, {"id": "30804", "name": "Sulpralex", "slug": "sulpralexcapsule500-mg", "dosage_form": "Capsule", "strength": "500 mg", "manufacturer": "Biopharma Laboratories Ltd.", "price": "৳ 12.05", "package_container": "Unit Price: ৳ 12.05,(30's pack: ৳ 361.50),"}, {"id": "26879", "name": "Supralex", "slug": "supralexpowder-for-suspension125-mg5-ml", "dosage_form": "Powder for Suspension", "strength": "125 mg/5 ml", "manufacturer": "Biopharma Laboratories Ltd.", "price": "৳ 77.29", "package_container": "100 ml bottle: ৳ 77.29"}]}