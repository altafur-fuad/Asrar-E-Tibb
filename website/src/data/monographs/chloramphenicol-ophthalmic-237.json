{"id": "237", "name": "Chloramphenicol (Ophthalmic)", "slug": "chloramphenicol-ophthalmic-237", "monograph_link": "https://medex.com.bd/attachments/7cizMA26ckUVYBFrwM4pAlGUM2uhDi/chloramphenicol-ophthalmic-capsules-suspension-prescribing-information", "drug_class": "Macrolides", "indication": "Whipple’s disease", "indication_description": "<div class=\"ac-body\">Chloramphenicol is indicated for the treatment of ocular infections involving the conjunctiva and/or cornea caused by chloramphenicol-susceptible organisms. Such as Staphylococcus aureus, Streptococcus pneumoniae, E.coli, H. influenzae, Klebsiella/Enterobacter spp, Moraxella lacunata, and Neisseria species.</div>", "therapeutic_class_description": "<div class=\"ac-body\">Ear Anti-Infectives &amp; Antiseptics, Eye Anti-Infectives &amp; Antiseptics, Macrolides</div>", "pharmacology_description": "<div class=\"ac-body\">Chloramphenicol is a broad-spectrum bacteriostatic antibiotic which acts through the inhibition of bacterial protein synthesis by interfering with the transfer of activated amino acids from soluble RNA to ribosomes.</div>", "dosage_description": "<div class=\"ac-body\"><strong>Adult and Children</strong>: Instill 1 or 2 drops in the conjunctival sac 4-6 times per day for the first 72 hours and then every 4 hours thereafter. Treatment should be continued for approximately 7 days, but should not be continued for more than 3 weeks without re-evaluation by the physician.</div>", "administration_description": "", "interaction_description": "<div class=\"ac-body\">Chymotrypsin may be inhibited if given simultaneously with Chloramphenicol.</div>", "contraindications_description": "<div class=\"ac-body\">It is contraindicated in individuals with a history of hypersensitivity to Chloramphenicol or any ingredients of the preparation.</div>", "side_effects_description": "<div class=\"ac-body\">The systemic adverse reaction has not been observed within short-term topical use of Chloramphenicol. The most frequently reported adverse reactions have been burning, stinging, conjunctival hyperemia, blood dyscrasia, allergic or inflammatory reactions, vesicular and maculopapular dermatitis.</div>", "pregnancy_and_lactation_description": "<div class=\"ac-body\">Safety for use in pregnancy and lactation has not been established. Therefore, use only when considered essential by the physicians.</div>", "precautions_description": "<div class=\"ac-body\">Chloramphenicol ophthalmic solution should never be given for minor infections or for prophylaxis. Repeated course and prolonged treatment should be avoided. Blood dyscrasias (granulocytopenia, thrombocytopenia and moderate anaemia) may occur after prolonged ophthalmic use.</div>", "pediatric_usage_description": "", "overdose_effects_description": "<div class=\"ac-body\">Accidental ingestion of the medicine is unlikely to cause any toxicity due to low content of antibiotic.</div>", "duration_of_treatment_description": "", "reconstitution_description": "", "storage_conditions_description": "<div class=\"ac-body\">Store in a cool (between 2°C-8°C) and dry place, protect from light, keep out of reach of children. Do not touch the dropper tip to the surface since this may contaminate the solution. Do not use after 30 days of the first opening.</div>", "brands": [{"id": "30808", "name": "Aristophen", "slug": "aristophenophthalmic-ointment1", "dosage_form": "Ophthalmic Ointment", "strength": "1%", "manufacturer": "Aristopharma Ltd.", "price": "৳ 8.39", "package_container": "3 gm tube: ৳ 8.39,5 gm tube: ৳ 13.00"}, {"id": "19195", "name": "Chlorphen", "slug": "chlorphenophthalmic-solution05", "dosage_form": "Ophthalmic Solution", "strength": "0.50%", "manufacturer": "Nipa Pharmaceuticals Ltd.", "price": "৳ 30.00", "package_container": "10 ml drop: ৳ 30.00"}, {"id": "8889", "name": "Chlorphen", "slug": "chlorphenophthalmic-ointment1", "dosage_form": "Ophthalmic Ointment", "strength": "1%", "manufacturer": "Nipa Pharmaceuticals Ltd.", "pric