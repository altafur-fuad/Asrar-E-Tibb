{"id": "211", "name": "Cefdinir", "slug": "cefdinir-211", "monograph_link": "https://medex.com.bd/attachments/jMiHzu3B42f8difJVzRAEad67aL9Iz/cefdinir-capsules-prescribing-information", "drug_class": "Third generation Cephalosporins", "indication": "Uncomplicated cystitis", "indication_description": "<div class=\"ac-body\">Cefdinir is indicated for the treatment of Community Acquired Pneumonia, Acute Exacerbation of Chronic Bronchitis, Acute Maxillary Sinusitis, Pharyngitis, Tonsillitis, Uncomplicated Skin and Skin Structure, Infections</div>", "therapeutic_class_description": "<div class=\"ac-body\">Third generation Cephalosporins</div>", "pharmacology_description": "<div class=\"ac-body\">Cefdinir binds to 1 or more of the penicillin-binding proteins (PBPs) which inhibit the final transpeptidation step of peptidoglycan synthesis in bacterial cell wall, thus inhibiting biosynthesis and arresting cell wall assembly resulting in bacterial cell death.</div>", "dosage_description": "<div class=\"ac-body\"><strong>Adult:</strong> 600 mg daily as a single or in 2 divided doses for 5-10 days.<br><strong>Child:</strong> <strong>≥6 months:</strong> 14 mg/kg daily as a single or in 2 divided doses. Max: 600 mg daily.</div>", "administration_description": "", "interaction_description": "<div class=\"ac-body\"><strong>Antacids</strong>: Cefdinir should be taken at least 2 hours interval of antacid administration.<br><br><strong>Iron supplement</strong>: Cefdinir should be taken at least 2 hours interval of iron supplement administration.<br><br><strong>Probencid</strong>: It inhibits the renal excretion of cefdinir.</div>", "contraindications_description": "<div class=\"ac-body\">Cefdinir is contraindicated in patients with known allergy to the cephalosporin class of antibiotics.</div>", "side_effects_description": "<div class=\"ac-body\">Common side effects are Diarrhea, Vaginal moniliasis, Nausea &amp; Vomiting, Headache, Rash etc.</div>", "pregnancy_and_lactation_description": "<div class=\"ac-body\">Pregnancy Category B. There are no adequate and well-controlled studies in pregnant women. This drug should be used during pregnancy only if clearly needed. Following administration of single 600 mg doses, Cefdinir was not detected in human breast milk.</div>", "precautions_description": "<div class=\"ac-body\">Cefdinir, as with other broad-spectrum antibiotics, should be prescribed with caution in individuals with a history of colitis. In patients with transient or persistent renal insufficiency (creatinine clearance &lt;30 ml/min), the total daily dose of Cefdinir should be reduced.</div>", "pediatric_usage_description": "", "overdose_effects_description": "<div class=\"ac-body\"><strong>Symptoms</strong>: Nausea, vomiting, epigastric distress, diarrhoea, convulsions. <br><br><strong>Management</strong>: Haemodialysis may be useful in the event of a serious toxic reaction particularly if renal function is compromised.</div>", "duration_of_treatment_description": "", "reconstitution_description": "", "storage_conditions_description": "<div class=\"ac-body\">Store between 20-25° C.</div>", "brands": [{"id": "28233", "name": "Adinir", "slug": "adinircapsule300-mg", "dosage_form": "Capsule", "strength": "300 mg", "manufacturer": "ACME Laboratories Ltd.", "price": "৳ 45.16", "package_container": "Unit Price: ৳ 45.16,(8's pack: ৳ 361.28),"}, {"id": "28234", "name": "Adinir", "slug": "adinirpowder-for-suspension125-mg5-ml", "dosage_form": "Powder for Suspension", "strength": "125 mg/5 ml", "manufacturer": "ACME Laboratories Ltd.", "price": "৳ 175.66", "package_container": "60 ml bottle: ৳ 175.66"}, {"id": "29921", "name": "Cednir DS", "slug": "cednir-dspowder-for-suspension250-mg5-ml", "dosage_form": "Powder for Suspension", "strength": "250 mg/5 ml", "manufacturer": "Eskayef Pharmaceuticals Ltd.", "price": "৳ 160.00", "package_container": "30 ml bottle: ৳ 160.00"}, {"id": "29920", "name": "Cednir", "slug": "cednircapsule300-mg", "dosage_form":