{"id": "113", "name": "Benzoic Acid + Salicylic Acid", "slug": "benzoic-acid-salicylic-acid-113", "monograph_link": "https://medex.com.bd/attachments/jrqjAKHhuWeQ3dPDbGzF9idwJeZQer/benzoic-acid-salicylic-acid-prescribing-information", "drug_class": "Other Antifungal preparations", "indication": "Fungal infections", "indication_description": "<div class=\"ac-body\">Benzoic Acid &amp; Salicylic Acid is indicated for fungal infections, athlete's foot, barber's itch.</div>", "therapeutic_class_description": "<div class=\"ac-body\">Other Antifungal preparations</div>", "pharmacology_description": "<div class=\"ac-body\"><strong>Benzoic acid:</strong> Elicits weak antifungal and antibacterial properties; also helps acidify urine.<br><br><strong>Salicylic acid: </strong>It has a potent keratolytic action and a slight antiseptic action when applied topically. It softens and destroys the stratum corneum by increasing endogenous hydration which causes the horny layer of the skin to swell, soften, and then desquamate. At high concentrations, salicylic acid has a caustic effect. It also possesses weak antifungal and antibacterial activity.</div>", "dosage_description": "<div class=\"ac-body\">Apply locally on the affected area 2-3 times per day.</div>", "administration_description": "", "interaction_description": "<div class=\"ac-body\">It is not known if this interacts with other topical medications applied to the treatment area. The use of this drug with other topical drugs has not been studied.</div>", "contraindications_description": "<div class=\"ac-body\">Hypersensitivity.</div>", "side_effects_description": "<div class=\"ac-body\">Irritation, sensitivity, excessive drying; systemic effects on prolonged use.</div>", "pregnancy_and_lactation_description": "<div class=\"ac-body\">Pregnancy Category-C. Animal reproduction studies have shown an adverse effect on the fetus and there are no adequate and well-controlled studies in humans, but potential benefits may warrant use of the drug in pregnant women despite potential risks</div>", "precautions_description": "<div class=\"ac-body\">Not for prolonged use in high concentrations and on large areas of the body. Avoid broken skin, mouth, eyes, mucous membranes and anogenital region.</div>", "pediatric_usage_description": "", "overdose_effects_description": "", "duration_of_treatment_description": "", "reconstitution_description": "", "storage_conditions_description": "", "brands": [{"id": "12453", "name": "Benzalic", "slug": "benzalicointment63", "dosage_form": "Ointment", "strength": "6%+3%", "manufacturer": "Central Pharmaceuticals Ltd.", "price": "৳ 14.00", "package_container": "20 gm tube: ৳ 14.00"}, {"id": "12452", "name": "Bensal", "slug": "bensalointment63", "dosage_form": "Ointment", "strength": "6%+3%", "manufacturer": "Gaco Pharmaceuticals Ltd.", "price": "৳ 25.00", "package_container": "25 gm tube: ৳ 25.00"}, {"id": "12454", "name": "Bexsul", "slug": "bexsulointment63", "dosage_form": "Ointment", "strength": "6%+3%", "manufacturer": "Edruc Limited", "price": "৳ 15.00", "package_container": "25 gm tube: ৳ 15.00"}, {"id": "28241", "name": "BS", "slug": "bsointment63", "dosage_form": "Ointment", "strength": "6%+3%", "manufacturer": "ACME Laboratories Ltd.", "price": "৳ 667.00", "package_container": "1 kg pack: ৳ 667.00"}, {"id": "12456", "name": "Dermin", "slug": "derminointment63", "dosage_form": "Ointment", "strength": "6%+3%", "manufacturer": "Jayson Pharmaceuticals Ltd.", "price": "৳ 20.06", "package_container": "25 gm tube: ৳ 20.06"}, {"id": "30639", "name": "Ensal", "slug": "ensalointment63", "dosage_form": "Ointment", "strength": "6%+3%", "manufacturer": "Renata Limited", "price": "৳ 265.00", "package_container": "1 kg pack: ৳ 265.00"}, {"id": "12458", "name": "G-Benzosal", "slug": "g-benzosalointment63", "dosage_form": "Ointment", "strength": "6%+3%", "manufacturer": "Gonoshasthaya Pharma Ltd.", "price": "৳ 12.00", "package_container": "25 gm tube: ৳ 12.00"}, {"id": "12461