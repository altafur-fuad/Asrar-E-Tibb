{"id": "205", "name": "Carboxymethylcellulose Sodium", "slug": "carboxymethylcellulose-sodium-205", "monograph_link": "https://medex.com.bd/attachments/M2B94yFKVM6fhIaddEyTu0DrxX78fC/carboxymethylcellulose-sodium-prescribing-information", "drug_class": "", "indication": "", "indication_description": "<div class=\"ac-body\">It is used as a lubricant to relieve irritation and discomfort due to dryness of the eye or due to exposure to wind or sun.</div>", "therapeutic_class_description": "", "pharmacology_description": "<div class=\"ac-body\">Carboxymethylcellulose binds to the surface of corneal epithelial cells via its glucopyranose subunits binding to glucose receptors GLUT-1. The residence time of carboxymethylcellulose bound to corneal cells is approximately 2 hours as indicated by a short-term binding assay. Binding of carboxymethylcellulose to the matrix proteins stimulated corneal epithelial cell attachment, migration, and re-epithelialization of corneal wounds.<br><br>This eye drop contains Carboxymethylcellulose Sodium similar to normal tears which acts as an ocular lubricant. It provides a lubricating and hydrating protective shield on the ocular surface.</div>", "dosage_description": "<div class=\"ac-body\">Instill 1 drop in the affected eye(s) 4 times a day or as needed.</div>", "administration_description": "", "interaction_description": "<div class=\"ac-body\">Not known.</div>", "contraindications_description": "<div class=\"ac-body\">This eye drop is contraindicated in patients with known hypersensitivity to any ingredient of the product.</div>", "side_effects_description": "<div class=\"ac-body\">Burning, Eye Irritation or Pruritus, Visual disturbance, Ocular discharge were reported with this eye drop.</div>", "pregnancy_and_lactation_description": "<div class=\"ac-body\">Safe use during pregnancy and lactation has not been established.</div>", "precautions_description": "<div class=\"ac-body\">Concomitant ocular medication should be administered 15 minutes prior to the instillation of this eye drop.</div>", "pediatric_usage_description": "<div class=\"ac-body\"><strong>Pediatric use</strong>: This eye drop should not be used in infants and small children under 3 years.<br><br><strong>Geriatric use</strong>: No overall differences in safety or effectiveness have been observed between elderly and other adult patients.</div>", "overdose_effects_description": "", "duration_of_treatment_description": "", "reconstitution_description": "", "storage_conditions_description": "<div class=\"ac-body\">The drug is to be used within 30 days after the first opening. Store at temperature not exceeding 30°C in a dry place. Protect from light. The bottle is to be closed strongly immediately after use. Keep away from the reach of children.</div>", "brands": [{"id": "18584", "name": "Aquafresh", "slug": "aquafreshophthalmic-solution1", "dosage_form": "Ophthalmic Solution", "strength": "1%", "manufacturer": "Popular Pharmaceuticals Ltd.", "price": "৳ 270.00", "package_container": "10 ml drop: ৳ 270.00,15 ml drop: ৳ 375.00"}, {"id": "28518", "name": "Carmelus", "slug": "carmelusophthalmic-solution1", "dosage_form": "Ophthalmic Solution", "strength": "1%", "manufacturer": "Pacific Pharmaceuticals Ltd.", "price": "৳ 275.00", "package_container": "10 ml drop: ৳ 275.00"}, {"id": "18582", "name": "Cfresh Liquigel", "slug": "cfresh-liquigelophthalmic-solution1", "dosage_form": "Ophthalmic Solution", "strength": "1%", "manufacturer": "Navana Pharmaceuticals Ltd.", "price": "৳ 270.00", "package_container": "10 ml drop: ৳ 270.00"}, {"id": "28927", "name": "CMC-Gel", "slug": "cmc-gelophthalmic-solution1", "dosage_form": "Ophthalmic Solution", "strength": "1%", "manufacturer": "Biopharma Laboratories Ltd.", "price": "৳ 250.00", "package_container": "10 ml drop: ৳ 250.00"}, {"id": "31725", "name": "Dewgel Liquigel", "slug": "dewgel-liquigelophthalmic-solution1", "dosage_form": "Ophthalmic Solution", "strength": "1%", "manufacturer": "Opso Saline