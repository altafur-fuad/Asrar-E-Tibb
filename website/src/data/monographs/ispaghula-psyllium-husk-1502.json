{"id": "1502", "name": "Ispaghula [Psyllium] Husk", "slug": "ispaghula-psyllium-husk-1502", "monograph_link": "https://medex.com.bd/attachments/A5B0pWeNr2oJczktPBRXOGc3CvILjI/ispaghula-psyllium-husk-prescribing-information", "drug_class": "Bulk-forming laxatives", "indication": "Constipation", "indication_description": "<div class=\"ac-body\">Psyllium Husk is indicated in-<br>\n<ul>\n<li>Constipation</li>\n<li>Raised levels of cholesterol</li>\n<li>Hemorrhoids or piles</li>\n<li>Irritable bowel syndrome (IBS)</li>\n<li>Reduces blood glucose level</li>\n</ul>\nPsyllium also provides easy bowel movement with smooth stool. So, it is desirable in patients with anal fissures, colon cancer, post anal &amp; rectal surgery and during pregnancy.</div>", "therapeutic_class_description": "<div class=\"ac-body\">Bulk-forming laxatives</div>", "pharmacology_description": "", "dosage_description": "<div class=\"ac-body\"><strong>Usual dose</strong>: 1 spoonful 1-3 times daily or as per doctor's advice.<br><br><strong>Adults and children over 12 years</strong>: 1 spoonful with water 2 times daily or as per doctor's advice.<br><br><strong>Children 6 to 12 years</strong>: ½ to 1 spoonful with water depending on age and size, in the morning and at bedtime or as per doctor's advice.<br><br><strong>Children below 6 years</strong>: Not recommended except as directed by the physician.<br><br>An additional glass of water is helpful after taking this gel.</div>", "administration_description": "<div class=\"ac-body\"><ul>\n<li>Take one spoonful with the provided spoon.</li>\n<li>Put this husk into an empty glass.</li>\n<li>Fill glass with water (150 ml or 2/3 of the glass) stir &amp; drink immediately.</li>\n</ul></div>", "interaction_description": "<div class=\"ac-body\">No significant interaction has been observed with other medicine.</div>", "contraindications_description": "<div class=\"ac-body\">Contraindicated in patients with gastrointestinal tract obstruction or threatening obstruction of the bowel.</div>", "side_effects_description": "<div class=\"ac-body\">Common side effects are flatulence, abdominal distension, gastro-intestinal obstruction.</div>", "pregnancy_and_lactation_description": "", "precautions_description": "", "pediatric_usage_description": "", "overdose_effects_description": "", "duration_of_treatment_description": "", "reconstitution_description": "", "storage_conditions_description": "<div class=\"ac-body\">Store in a cool and dry place. Keep out of reach of children.</div>", "brands": [{"id": "27598", "name": "Fiberlax", "slug": "fiberlaxeffervescent-powder35-gm54-gm", "dosage_form": "Effervescent Powder", "strength": "3.5 gm/5.4 gm", "manufacturer": "Incepta Pharmaceuticals Ltd.", "price": "৳ 400.00", "package_container": "130 gm container: ৳ 400.00"}, {"id": "31904", "name": "Fibosyl", "slug": "fibosyleffervescent-powder35-gm54-gm", "dosage_form": "Effervescent Powder", "strength": "3.5 gm/5.4 gm", "manufacturer": "Aristopharma Ltd.", "price": "৳ 400.00", "package_container": "120 gm container: ৳ 400.00"}, {"id": "31925", "name": "Fibosyl", "slug": "fibosyleffervescent-powder35-gmsachet", "dosage_form": "Effervescent Powder", "strength": "3.5 gm/sachet", "manufacturer": "Aristopharma Ltd.", "price": "৳ 15.00", "package_container": "3.5 gm sachet: ৳ 15.00,(30's pack: ৳ 450.00),"}, {"id": "21158", "name": "Isobgul", "slug": "isobguleffervescent-powder35-gmsachet", "dosage_form": "Effervescent Powder", "strength": "3.5 gm/sachet", "manufacturer": "Eskayef Pharmaceuticals Ltd.", "price": "৳ 8.00", "package_container": "3.5 gm sachet: ৳ 8.00,(20's pack: ৳ 160.00),"}, {"id": "26759", "name": "Isobgul", "slug": "isobguleffervescent-powder35-gm54-gm", "dosage_form": "Effervescent Powder", "strength": "3.5 gm/5.4 gm", "manufacturer": "Eskayef Pharmaceuticals Ltd.", "price": "৳ 395.00", "package_container": "140 gm container: ৳ 395.00"}, {"id": "27514", "name": "Ispergul", "slug": "isperguleffervescent-powder35-gm54-gm", "dosage_fo