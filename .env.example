# Documentation template only — no secret values.
# Do not copy production secrets into this file or commit .env files.

# Website public configuration (only if implemented)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_CLIENT_SAFE_PUBLISHABLE_KEY
NEXT_PUBLIC_API_BASE_URL=https://YOUR_RENDER_SERVICE.onrender.com
NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/altafur-fuad/Asrar-E-Tibb/releases/latest

# Rust API server configuration (server only)
PORT=10000
APP_ENV=development
RUST_LOG=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Configure JWT issuer/JWKS values according to the chosen verified implementation.
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1

# Add payment/provider secrets only after a provider is selected; never commit values.
# PAYMENT_PROVIDER_SECRET=
# PAYMENT_WEBHOOK_SECRET=
